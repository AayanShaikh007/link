# Leave public Supabase values empty for the browser-only demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never use a NEXT_PUBLIC prefix on these values.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Must match the exact frontend origin, without a hash or path.
APP_URL=http://localhost:3000
# Optional sandbox seeding. Never run against production.
SEED_CONFIRM=
SEED_PASSWORD=
