{
  "name": "forge-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "format": "prettier --write src tests scripts docs README.md *.ts *.json *.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@supabase/supabase-js": "^2.0.0",
    "stripe": "^20.0.0",
    "zod": "^4.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.0.0",
    "vite": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@electric-sql/pglite": "^0.3.0",
    "prettier": "^3.6.0"
  },
  "type": "module"
}
